# ArcoraDEX frontend env vars.
# All values can be overridden via Vercel project settings.

# Chain (Arc Testnet)
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_BLOCK_EXPLORER=https://testnet.arcscan.app

# v1.0-testnet contract addresses (defaults baked into lib/contracts.ts).
