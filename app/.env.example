# ArcoraDEX frontend env vars.
# All values can be overridden via Vercel project settings.

# Chain (Arc Testnet)
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_BLOCK_EXPLORER=https://testnet.arcscan.app

# V3-testnet defaults baked into the SDK's DEFAULT_ADDRESSES (packages/sdk/src/addresses.ts).
# The frontend uses these defaults; the env vars below are optional overrides for
# pointing the UI at a different deploy. NOT read by the SDK provider today —
# kept for forward-compatibility if app/lib ever wires them up.
# 2026-06-10 fresh Arc testnet redeploy (Branch C); supersedes 2026-06-06 (keys lost).
NEXT_PUBLIC_POOL_ADDRESS=0x214825E3e24a07cd58e48267e492320dAccCe2f6
NEXT_PUBLIC_REGISTRY_ADDRESS=0x372f83a1432Aa43b72eDCE083DC8352d9Bfb47f1
NEXT_PUBLIC_LP_ADDRESS=0xc07e979B5Ee023Ad96E65E733b99902306CAFEf2

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
NEXT_PUBLIC_WC_PROJECT_ID=

# Public origin of the deployed app, e.g. https://arcoradex.vercel.app.
# Used by /api/faucet to enforce same-origin POSTs (CSRF defense). L-11
# (audit 2026-05-31): in production (NODE_ENV=production or
# VERCEL_ENV=production) the faucet FAILS CLOSED (403) when this is unset —
# set it on the production deploy. Left blank in dev, where the check is
# skipped so local testing works.
NEXT_PUBLIC_APP_URL=

# Faucet rate-limit store (M-3, audit 2026-05-31).
# When BOTH are set, the /api/faucet cooldown + in-flight reservation + hourly
# mint-budget use Upstash Redis (cross-instance, atomic SET-NX). When unset,
# the route falls back to an in-memory per-instance store (dev/test only —
# does NOT enforce limits across Vercel function instances). Provision an
# Upstash Redis DB (https://console.upstash.com) and set these in the Vercel
# project for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
