NEXT_PUBLIC_REGISTRY_ADDRESS=0x920E3E59DD37Be3D9D3750D7B912A9dd08db0D29
NEXT_PUBLIC_LP_ADDRESS=0x7CEAbF411806A29ffaEbCAB2BF3Dc8a9ECBD110C

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
NEXT_PUBLIC_WC_PROJECT_ID=
