# ArcoraDEX frontend env vars.
# All values can be overridden via Vercel project settings.

# Chain (Base Sepolia — the default V2 ledger, 84532)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BLOCK_EXPLORER=https://sepolia.basescan.org

# Arc testnet (5042002) RPC override. Optional — wagmi and /api/faucet fall
# back to the SDK chain default (https://rpc.testnet.arc.network) when unset.
NEXT_PUBLIC_ARC_RPC_URL=

# V2 defaults baked into the SDK's DEFAULT_ADDRESSES_V2 (packages/sdk/src/addresses.v2.ts).
# The frontend uses these defaults; the env vars below are optional overrides for
# pointing the UI at a different deploy. NOT read by the SDK provider today —
# kept for forward-compatibility if app/lib ever wires them up.
# Live Base Sepolia (84532) V2 deploy (2026-06-10).
NEXT_PUBLIC_POOL_ADDRESS=0x63FD6180dC6Aa5aE2941Bd28D2dc34c54F2b7820
NEXT_PUBLIC_REGISTRY_ADDRESS=0xae1f10b007cDC4131797A45232a3D52Ff2C314e2
NEXT_PUBLIC_LP_ADDRESS=0x02aFC4c2c72ecE2049725DA2bd9080EF6285c844

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
NEXT_PUBLIC_WC_PROJECT_ID=

# Faucet minter key. The /api/faucet route mints the V2 mock stablecoins
# (USDC/USDT/EURC) to claimants by calling each token's `mint(address,uint256)`
# on the chain the UI requests (Base Sepolia 84532 or Arc testnet 5042002).
# The SAME key signs on both chains — it must own the mock tokens and hold gas
# on BOTH (Arc gas is USDC). Do NOT commit a real key.
FAUCET_PRIVATE_KEY=

# Public origin of the deployed app, e.g. https://arcoradex.vercel.app.
# Used by /api/faucet to enforce same-origin POSTs (CSRF defense). L-11
# (audit 2026-05-31): in production (NODE_ENV=production or
# VERCEL_ENV=production) the faucet FAILS CLOSED (403) when this is unset —
# set it on the production deploy. Left blank in dev, where the check is
# skipped so local testing works.
NEXT_PUBLIC_APP_URL=

# Faucet rate-limit store (M-3, audit 2026-05-31).
# When BOTH are set, the /api/faucet cooldown + in-flight reservation + hourly
# mint-budget use Upstash Redis (cross-instance, atomic SET-NX). When unset,
# the route falls back to an in-memory per-instance store (dev/test only —
# does NOT enforce limits across Vercel function instances). Provision an
# Upstash Redis DB (https://console.upstash.com) and set these in the Vercel
# project for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
