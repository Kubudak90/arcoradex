[Unit]
Description=Arcora v0.7 — push CoinGecko prices to MockChainlinkFeeds (Arc testnet)
Documentation=https://github.com/Kubudak90/arcora-v0.7-shared-vault-pool

[Service]
Type=oneshot
WorkingDirectory=/root/arcora-v07-feeds
EnvironmentFile=/root/arcora-v07-feeds/.env
ExecStart=/usr/bin/node /root/arcora-v07-feeds/multi-feed-push.mjs
Nice=10
StandardOutput=journal
StandardError=journal
