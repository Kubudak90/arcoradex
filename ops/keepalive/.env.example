# ArcoraDEX multi-feed keeper — required env vars for /home/arcora/arcoradex-feeds/.env.
#
# Copy to .env on the VPS and fill in real values. Never commit the .env.
#
# NOTE: The keeper signing keys are NOT listed here. They are fetched from Vault
# at unit start by ops/keepalive/fetch-keeper-secret.sh and exposed in the
# per-service tmpfs env file (deleted on stop). H-2 (audit 2026-05-31): the
# PRIMARY feeds are signed by KEEPER_PRIMARY_KEY and the SECONDARY feeds by a
# SEPARATE KEEPER_SECONDARY_KEY (the two MUST differ). KEEPER_PRIVATE_KEY is kept
# as a back-compat alias for the primary key (also used by guard-record.mjs).
# Do not add KEEPER_PRIMARY_KEY/KEEPER_SECONDARY_KEY/KEEPER_PRIVATE_KEY or
# DEPLOYER_PRIVATE_KEY to this file.

# Primary RPC. May be a SINGLE url or a COMMA-SEPARATED list; a list builds a
# viem fallback() transport (auto-retry + failover). L-4 (audit 2026-05-31).
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Optional second RPC appended after ARC_TESTNET_RPC in the fallback transport.
ARC_TESTNET_RPC_FALLBACK=

# Optional: only needed if you have a CoinGecko Pro API key. Without it the
# script uses the public endpoint, which is rate-limited (~10-50 req/min).
COINGECKO_API_KEY=

# --- L-4 (audit 2026-05-31) keeper liveness/gas hardening (all optional) ---
# Per-tx fee ceiling in gwei. The keeper never signs a tx above maxFeePerGas,
# capping the damage a misbehaving RPC fee suggestion can do.
KEEPER_MAX_FEE_GWEI=50
KEEPER_MAX_PRIORITY_GWEI=2
# AbortController timeout (ms) on each CoinGecko / FX fetch (L-3).
KEEPER_FETCH_TIMEOUT_MS=12000
# waitForTransactionReceipt wall-clock timeout (ms).
KEEPER_TX_TIMEOUT_MS=90000
# Startup keeper-balance floors (ARC). Warn below MIN, abort below ABORT.
KEEPER_MIN_BALANCE_ETHER=0.05
KEEPER_ABORT_BALANCE_ETHER=0.005

# --- I-11 (audit 2026-05-31): guard-record.mjs / guard-monitor.mjs addresses ---
# CumulativeDeviationGuard + ArcoraDexRegistry addresses, sourced from env so a
# Registry/Guard redeploy is a config change, not a code change. If unset,
# the scripts fall back to the current live addresses baked in as defaults.
GUARD_ADDRESS=0x035447f8d97A23fFfC32aa8bFb8ffDbC7B94E608
REGISTRY_ADDRESS=0x9914436E5245bF3c0d4D4338e0a8b8F5Ab5505aB

# --- L-2 (audit 2026-05-31): FX reference-drift cross-check ---
# Independent FX source used to cross-check the CoinGecko-derived FX value before
# pushing EURC/TRYC/BRLC. Default "exchangerate.host" (free, no key); "none"
# disables the cross-check (band + peg-drift only). A push is skipped when the two
# sources disagree beyond FX_REF_TOLERANCE_BPS, OR when the reference is missing
# and the cross-check is enabled (fail safe).
FX_REFERENCE_SOURCE=exchangerate.host
FX_REF_TOLERANCE_BPS=200

# --- guard-monitor.mjs (CumulativeDeviationGuard → monitor pipeline) ---
# Optional webhook the monitor POSTs to when it pages (Slack/Upstash/PagerDuty-
# compatible {"text": ...}). Manual-in-the-loop: the monitor NEVER auto-pauses;
# pausing remains a human Pause-Guardian Safe action. Empty = log-only.
ALERT_WEBHOOK_URL=
# Block lookback per run (must cover the timer interval so no trip is missed).
GUARD_MONITOR_LOOKBACK_BLOCKS=2000
# Per-token page cooldown (ms) — debounces a spammed event stream.
GUARD_MONITOR_COOLDOWN_MS=3600000
# bps tolerance for "the independent feed confirms the on-chain price is real".
GUARD_MONITOR_CONFIRM_TOLERANCE_BPS=300

# MockChainlinkFeedV2 PRIMARY feed addresses deployed during the 2026-05-10
# key-separation cutover. Canonical source is the live VPS
# /home/arcora/arcoradex-feeds/.env; the 2026-05-06 ArcoraDEX deploy doc lists
# the pre-V2 oracle addresses.
FEED_USDC=0x2E6B862E1Ac74328238494B22317262004534B39
FEED_USDT=0x741af784a1d4C69843A1764099433160088a1c70
FEED_PYUSD=0x2285FeDA1F9c07959db2b97bFC8F9cCBCDb51896
FEED_DAI=0xAAC5a5855deF9414f7330f350c2E00119C2097c8
FEED_EURC=0x0656C1DeBCa98fAE7447ad8b0DF38C444833A170
FEED_TRYC=0xB49BF86c11b5A949dd91819bB1BA1399b6bbDf9C
FEED_BRLC=0x8Ee5C63efea3Ac2807a45A00D45507f3514B612d

# P3 SECONDARY feed addresses — second oracle source for the OracleAggregator
# divergence guard. H-10 (audit 2026-05-24): if these are missing on a fresh
# VPS provision, multi-feed-push.mjs logs "feed address env missing — skip"
# for every secondary, leaving the secondary feeds permanently stale and
# breaking the divergence guard. Pull live values from the canonical VPS
# .env or look them up via ExecuteP3Batch's P3_AGG_* envs from the 2026-05-19
# Timelock execution. Placeholders below MUST be replaced.
P3_SECONDARY_USDC=0x0000000000000000000000000000000000000000
P3_SECONDARY_USDT=0x0000000000000000000000000000000000000000
P3_SECONDARY_PYUSD=0x0000000000000000000000000000000000000000
P3_SECONDARY_DAI=0x0000000000000000000000000000000000000000
P3_SECONDARY_EURC=0x0000000000000000000000000000000000000000
P3_SECONDARY_TRYC=0x0000000000000000000000000000000000000000
P3_SECONDARY_BRLC=0x0000000000000000000000000000000000000000
